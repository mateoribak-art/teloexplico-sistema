*.mp4
*.wav
*.mov
videos/*/cuadros/
videos/en/*/cuadros/
# generados
PANEL.html
__pycache__/
*.pyc
# la música y los efectos sí (los usa el render en la nube)
!motor/public/musica/*.wav
!motor/public/sfx/*.wav
PANEL_en.html

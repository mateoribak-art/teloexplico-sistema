#!/usr/bin/env bash
# tlx: un solo comando para todas las herramientas de @teloexplico.ar
#
#   tlx voz <slug> [--regenerar]   voz con Gemini + tiempos por palabra
#   tlx cuadros <slug> f1 f2 ...    cuadros sueltos para revisar (videos/<slug>/cuadros/)
#   tlx render <slug>               video final normalizado a -14 LUFS + portada
#   tlx control <slug>              control técnico (formato, volumen, voz = guion, chequeo de datos)
#   tlx cola [estado <slug> <estado> [motivo] | agregar <slug> "<tema>"]
#   tlx tsc                         chequeo de tipos del motor
#   tlx taller                      dibuja el objeto de motor/src/taller/Taller.tsx (grande + chico)
#   tlx catalogo                    lámina con toda la biblioteca de objetos
#   tlx metricas [actualizar]       ranking de reels por rendimiento (actualizar baja datos nuevos)
#   tlx comentarios pendientes      comentarios nuevos sin responder
#   tlx comentarios responder|saltear|alerta <id> "<texto o motivo>"
set -euo pipefail
RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="/c/Users/Mateo/AppData/Local/Programs/Python/Python312/python.exe"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"   # en la nube (Linux)
H="$RAIZ/herramientas"
M="$RAIZ/motor"
# 3D: en la notebook usa la placa de video (angle); en la nube no hay, va por software (swangle)
if [[ "$OSTYPE" == msys* || "$OSTYPE" == cygwin* ]]; then GL=angle; else GL=swangle; fi


cmd="${1:-}"; shift || true
case "$cmd" in
  voz)     cd "$H" && "$PY" -I voz.py "$@" ;;
  control) cd "$H" && "$PY" -I control.py "$@" ;;
  cola)    cd "$H" && "$PY" -I cola.py "$@" ;;
  metricas) cd "$H" && "$PY" -I metricas.py "$@" ;;
  comentarios) cd "$H" && "$PY" -I comentarios.py "$@" ;;
  tsc)     cd "$M" && npx tsc --noEmit ;;
  cuadros)
    slug="$1"; shift
    mkdir -p "$RAIZ/videos/$slug/cuadros"
    cd "$M"
    # se arma el proyecto una sola vez y cada cuadro sale de ahí (antes se rearmaba por cuadro: lento en 3D)
    npx remotion bundle --out-dir="$M/.bundle-cuadros" --log=error >/dev/null
    for f in "$@"; do
      npx remotion still "$M/.bundle-cuadros" "h$slug" "$RAIZ/videos/$slug/cuadros/f$f.png" --frame="$f" --scale=0.5 --gl=$GL --log=error
    done
    cd "$RAIZ/videos/$slug/cuadros"
    # grilla de 4 columnas: así cada cuadro se ve lo bastante grande para revisar detalles
    entradas=(); for f in "$@"; do entradas+=(-i "f$f.png"); done
    filas=$(( ($# + 3) / 4 ))
    ffmpeg -v error -y "${entradas[@]}" -filter_complex "concat=n=$#:v=1:a=0,tile=4x$filas:padding=10:color=white" -frames:v 1 hoja.png
    echo "hoja de cuadros: videos/$slug/cuadros/hoja.png"
    ;;
  render)
    slug="$1"
    cd "$M"
    npx remotion render "h$slug" "$RAIZ/videos/$slug/render.mp4" --codec=h264 --crf=18 --audio-codec=aac --gl=$GL --log=error
    npx remotion still "p$slug" "$RAIZ/videos/$slug/portada.png" --gl=$GL --log=error
    cd "$RAIZ/videos/$slug"
    ffmpeg -v error -y -i render.mp4 -c:v copy -af "loudnorm=I=-14:TP=-1.5:LRA=11" -ar 48000 -c:a aac -b:a 256k -movflags +faststart "$slug.mp4"
    rm -f render.mp4
    echo "render listo: videos/$slug/$slug.mp4 ($(ffprobe -v error -show_entries format=duration -of csv=p=0 "$slug.mp4") s)"
    ;;
  taller)
    # dibuja motor/src/taller/Taller.tsx (objeto nuevo en grande y en chico) para pulirlo antes de usarlo
    mkdir -p "$RAIZ/videos/_taller"
    cd "$M" && npx remotion still taller "$RAIZ/videos/_taller/taller.png" --scale=0.6 --log=error
    echo "taller: videos/_taller/taller.png"
    ;;
  catalogo)
    # lámina con toda la biblioteca de objetos (motor/src/taller/Catalogo.tsx)
    mkdir -p "$RAIZ/videos/_taller"
    cd "$M" && npx remotion still catalogo "$RAIZ/videos/_taller/catalogo.png" --log=error
    echo "catálogo: videos/_taller/catalogo.png"
    ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
